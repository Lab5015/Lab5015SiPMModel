void myLoadData(std::vector<std::string> runs, const std::string& inFolder, const std::string& baseName, const std::string& psName)
{
  for(unsigned int iRun = 0; iRun < nRuns; ++iRun)
  {
    SiPMParams sipmPars = SiPMParamsVec.at(iRun);  
    
    TFile* inFile = TFile::Open(Form("%s/%s_run%s.root",inFolder.c_str(),baseName.c_str(),runsVec[iRun].c_str()),"READ");
    std::cout << Form("%s/%s_run%s.root",inFolder.c_str(),baseName.c_str(),runsVec[iRun].c_str()) << std::endl;
    
    if( !isTOFHIR )
      {
	TGraph* g_temp;	
	g_temp = (TGraph*)( inFile->Get(Form("%s",psName.c_str())) );
	double x,y;
	for(int iPoint = 0; iPoint < g_temp->GetN(); ++iPoint)
	  {
	    g_temp -> GetPoint(iPoint,x,y);
	    g_data[iRun] -> SetPoint(iPoint,x-40.,y);
	    g_data[iRun] -> SetPointError(iPoint,0.,0.002);
	  }
	
      }
    else
      {
	TGraph* g_temp = (TGraphErrors*)( inFile->Get(Form("%s_Vov%.2f",psName.c_str(),sipmPars.OV)) );
	g_data[iRun] = new TGraphErrors();
	double x,y, ey;
	for(int iPoint = 0; iPoint < int(0.5*g_temp->GetN()); ++iPoint)
	  {
	    g_temp -> GetPoint(iPoint,x,y);
	    if( y > sipmPars.fitYMax ) continue;
	    g_data[iRun] -> SetPoint(g_data[iRun]->GetN(),x+1.,y);
	    g_data[iRun] -> SetPointError(g_data[iRun]->GetN()-1,0.,0.2);
	  }
	for(int iPoint = 0; iPoint < int(0.5*g_temp->GetN()); ++iPoint)
	  {
	    g_temp -> GetPoint(g_temp->GetN()-iPoint-1,x,y);
	    if( y > sipmPars.fitYMax ) continue;
	    g_data[iRun] -> SetPoint(g_data[iRun]->GetN(),x+1.,y);
	    g_data[iRun] -> SetPointError(g_data[iRun]->GetN()-1,0.,0.2);
	  }
      }
    inFile->Close();
  }
  
  return;
}



// ******************************
// SiPM model on an external load
// ******************************
void myInSignal(const int& iRun, double* par = NULL)
{
  SiPMParams* sipmPars = &(SiPMParamsVec.at(iRun));

  double amp = amp0;
  double t0  = t00;
  double Rq  = (*sipmPars).Rq;
  double Cd  = (*sipmPars).Cd;
  double BW  = BW0;
  double BW2 = BW20;
  double BW3 = BW30;
  
  if( par )
    {
      if( parIndex[0+7*iRun] >= 0 ) amp = par[parIndex[0+7*iRun]];
      if( parIndex[1+7*iRun] >= 0 )  t0 = par[parIndex[1+7*iRun]];
      if( parIndex[2+7*iRun] >= 0 )  Rq = par[parIndex[2+7*iRun]];
      if( parIndex[3+7*iRun] >= 0 )  Cd = par[parIndex[3+7*iRun]];
      if( parIndex[4+7*iRun] >= 0 )  BW = par[parIndex[4+7*iRun]];
      if( parIndex[5+7*iRun] >= 0 ) BW2 = par[parIndex[5+7*iRun]];
      if( parIndex[6+7*iRun] >= 0 ) BW3 = par[parIndex[6+7*iRun]];
      
      amp0 = amp;
      t00 = t0;
      BW0 = BW;
      BW20 = BW2;
      BW30 = BW3;
    }
  
  (*sipmPars).Rq = Rq;
  (*sipmPars).Cd = Cd;
  
  fitPars[0+7*iRun] = amp;
  fitPars[1+7*iRun] = t0;
  fitPars[2+7*iRun] = Rq;
  fitPars[3+7*iRun] = Cd;
  fitPars[4+7*iRun] = BW;
  fitPars[5+7*iRun] = BW2;
  fitPars[6+7*iRun] = BW3;
  
  // bandwidth low-pass filter
  double tau_band = 1./(BW*3.14159*2.)*1e3; // nanosenconds (BW is in MHz)
  
  // L/R low-pass filter
  double tau_band2 = 1./((BW+BW2)*3.14159*2.)*1e3; // nanosenconds (BW is in MHz)
  
  double tau1 = 1./(BW*3.14159*2.)*1e3; // nanosenconds (BW is in MHz)
  double tau2 = 0.133;
  double GNpe = ((*sipmPars).Cq+(*sipmPars).Cd)*((*sipmPars).OV+0.25)/(1.602*1e-19)*(*sipmPars).Npe;
  //double BW2fix = 10.275 + 8.92558e-09*GNpe; 
  double BW2fix = GNpe < 4.06809e+08 ? 0. : 6.50098e-09*(GNpe-4.06809e+08);
  double tau3 = 1./(BW2fix*3.14159*2.)*1e3; // nanosenconds (BW is in MHz)
  
  //double tauE = 0.5736; // from Elmore
  double tauE = 1./(BW3*3.14159*2.)*1e3; // from fit
  
  double tauHP2 = 1./(30.*3.14159*2.)*1e3; // additional HP with 30 MHz pole -- effective in 2C 30 MHz
  
  // Hitograms for FFT analysis 
  for(int ipt = 0; ipt <= npt; ++ipt)
  { 
    double tt = (double)ipt * (tmax/npt);
    
    hSiPM[iRun] -> SetBinContent(ipt+1, 0.5*((*sipmPars).RF)*SiPMPulseShape(tt,*sipmPars,amp,t0)); // 0.5*RF is the total transimpedance
    //hSiPM[iRun] -> SetBinContent(ipt+1, 5.*0.5*((*sipmPars).RF)*SiPMPulseShape(tt,*sipmPars,amp,t0)); // 0.5*RF is the total transimpedance, 5x for the high gain output
    
    // AdvanSid bandwidth
    hBand[iRun]     -> SetBinContent(ipt+1, (1.-0.5/(freq*tau_band))*funcLP(tt,tau_band));
    hBand2[iRun]    -> SetBinContent(ipt+1, (1.-0.5/(freq*tau_band2))*funcLP(tt,tau_band2));
    
    // TOFHIR bandwidth
    hLowP[iRun] -> SetBinContent(ipt+1, 1./freq*(1.-0.5/(freq*tau1))*funcLP(tt,tau1) );
    hDisc[iRun] -> SetBinContent(ipt+1, 1./freq*(1.-0.5/(freq*tau2))*funcLP(tt,tau2) );
    if( ipt == 0 )
      {
	hHigP[iRun] -> SetBinContent(ipt+1, 1.-1./freq*(1.-0.5/(freq*tau3))*funcLP(tt,tau3) );
	hHigP2[iRun] -> SetBinContent(ipt+1, 1.-1./freq*(1.-0.5/(freq*tauHP2))*funcLP(tt,tauHP2) );
	hDelP[iRun] -> SetBinContent(ipt+1, 1.-1./freq*(1.-0.5/(freq*tauE))*funcLP(tt,tauE) );
	hNorm[iRun] -> SetBinContent(ipt+1,1.725e06);
      }
    else
      {
	hHigP[iRun] -> SetBinContent(ipt+1, 0.-1./freq*(1.-0.5/(freq*tau3))*funcLP(tt,tau3) );
	hHigP2[iRun] -> SetBinContent(ipt+1, 0.-1./freq*(1.-0.5/(freq*tauHP2))*funcLP(tt,tauHP2) );
	hDelP[iRun] -> SetBinContent(ipt+1, 0.-1./freq*(1.-0.5/(freq*tauE))*funcLP(tt,tauE) );
	hNorm[iRun] -> SetBinContent(ipt+1,0.);
      }
  }
  
  hBand[iRun] -> Scale(1./hBand[iRun]->Integral());
  hBand2[iRun] -> Scale(1./hBand2[iRun]->Integral());
    
  // convolutions
  if( !isTOFHIR )
    {
      hConvol(hSiPM[iRun],hLaser[iRun],hInTot[iRun]);
      hConvol(hInTot[iRun],hBand[iRun],hOuTot[iRun]);
      hConvol(hOuTot[iRun],hBand2[iRun],hOuTot[iRun]);
    }
  
  else
    {
      //hConvol(hSiPM[iRun],hLaser[iRun],hInTot[iRun]);
      hConvol(hSiPM[iRun],hLYSO[iRun],hInTot[iRun]);
      hConvol(hInTot[iRun],hHigP[iRun],hOuTot[iRun]);
      hConvol(hOuTot[iRun],hLowP[iRun],hOuTot[iRun]);
      hConvol(hOuTot[iRun],hHigP2[iRun],hOuTot[iRun]);
      hConvol(hOuTot[iRun],hDisc[iRun],hOuTot[iRun]);
      hConvol(hOuTot[iRun],hDelP[iRun],hOuTot[iRun]);
      hConvol(hOuTot[iRun],hNorm[iRun],hOuTot[iRun]);
    }  
  return;
} 



// ******************************
// Compute error band
// ******************************

TGraphAsymmErrors* GetConfidenceInterval(const int& iRun, const int& nToys)
{
  TGraphAsymmErrors* ret = new TGraphAsymmErrors();
  
  int N = hOuTot[iRun] -> GetNbinsX();
  for(int iBin = 1; iBin <= N; ++iBin)
    {
      double center = hOuTot[iRun] -> GetBinCenter(iBin);
      double content = hOuTot[iRun] -> GetBinContent(iBin);
      ret -> SetPoint(iBin-1,center,content);
    }
  
  SiPMParams* sipmPars = &(SiPMParamsVec.at(iRun));
  TRandom3 r;
  
  std::map<int,std::vector<double> > vals;
  for(int iToy = 0; iToy < nToys; ++iToy)
    {
      float RqStart = (*sipmPars).Rq;
      float RqErr = (*sipmPars).RqErr;
      (*sipmPars).Rq = RqStart + 1.*r.Gaus(0.,RqErr);
      
      float CqStart = (*sipmPars).Cq;
      float CqErr = (*sipmPars).CqErr;
      (*sipmPars).Cq = CqStart + 1.*r.Gaus(0.,CqErr);
      
      float RdStart = (*sipmPars).Rd;
      float RdErr = (*sipmPars).RdErr;
      (*sipmPars).Rd = RdStart + 1.*r.Gaus(0.,RdErr);
      
      float CdStart = (*sipmPars).Cd;
      float CdErr = (*sipmPars).CdErr;
      (*sipmPars).Cd = CdStart + 1.*r.Gaus(0.,CdErr);
      
      float CgStart = (*sipmPars).Cg;
      float CgErr = (*sipmPars).CgErr;
      (*sipmPars).Cg = CgStart + 1.*r.Gaus(0.,CgErr);
      
      float RLStart = (*sipmPars).RL;
      float RLErr = (*sipmPars).RLErr;
      (*sipmPars).RL = RLStart + 1.*r.Gaus(0.,RLErr);
      
      myInSignal(iRun,NULL);
      
      for(int iBin = 1; iBin <= N; ++iBin)
	{
	  vals[iBin].push_back( hOuTot[iRun]->GetBinContent(iBin) );
	}
      
      (*sipmPars).Rq = RqStart;
      (*sipmPars).Cq = CqStart;
      (*sipmPars).Rd = RdStart;
      (*sipmPars).Cd = CdStart;
      (*sipmPars).Cg = CgStart;
      (*sipmPars).RL = RLStart;
    }

  for(int iBin = 1; iBin <= N; ++iBin)
    {
      std::vector<double> vec = vals[iBin];
      std::pair<double,double> cl = FindSmallestInterval(&vec);
      
      double x,y;
      ret -> GetPoint(iBin-1,x,y);
      ret -> SetPointEYhigh(iBin-1,cl.second-0.5*(cl.first+cl.second));
      ret -> SetPointEYlow(iBin-1,0.5*(cl.first+cl.second)-cl.first);
    }
  
  return ret;
}




