    double xx, yy;
    for(int iPoint = 0; iPoint < g_data[iRun]->GetN(); ++iPoint)
    {
      g_data[iRun] -> GetPoint(iPoint,xx,yy);
      if( Amax <  yy ) 
	  Amax = yy;
    }
    for(int iBin = 1; iBin <= hOuTot[iRun]->GetNbinsX(); ++iBin)
      {
