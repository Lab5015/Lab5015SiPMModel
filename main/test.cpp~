std::vector<SiPMParams> SiPMParamsVec;
std::vector<std::string> runsVec;

// Define time axis and binning
const int npt     = int(pow(2,13));
const double tmax = 409.6;
const double freq = npt / tmax;




int main(int argc, char** argv)
{
  //----------------------
  // parse the config file
  CfgManager opts;
  opts.ParseConfigFile(argv[1]);
  
  
  //------------------------  
  // get the SiPM parameters
  GetSiPMParsFromCfg(argv[1],SiPMParamsVec,&runsVec);
  SiPMParams* sipmPars = &(SiPMParamsVec.at(0));
  float BWLP = opts.GetOpt<float>("Input.BWLP");
  float BWHP = opts.GetOpt<float>("Input.BWHP");
  
  TH1D* hSiPM    = new TH1D("hSiPM", "",npt,0,tmax); // SiPM pulse
  TH1D* hLowP    = new TH1D("hLowP", "",npt,0,tmax); // readout board bandwidth
  TH1D* hHigP    = new TH1D("hHigP", "",npt,0,tmax); // readout board bandwidth
  TH1D* hOuTotLP = new TH1D("hOuTotLP","",npt,0,tmax); // output
  TH1D* hOuTotHP = new TH1D("hOuTotHP","",npt,0,tmax); // output
  
  
  //-----------------------
  // fill static histograms
  
  for(int ipt = 0; ipt <= npt; ++ipt)
  { 
    double tt = (double)ipt * (tmax/npt);
    hSiPM -> SetBinContent(ipt+1, SiPMPulseShape(tt,*sipmPars,1.,0.));
  }
  
  //---------------------------
  // Hitograms for FFT analysis 
  
  double tauLP = 1./(BWLP*3.14159*2.)*1e3;
  double tauHP = 1./(BWHP*3.14159*2.)*1e3;
  
  for(int ipt = 0; ipt <= npt; ++ipt)
  { 
    double tt = (double)ipt * (tmax/npt);
    
    hLowP -> SetBinContent(ipt+1, 1./freq*(1.-0.5/(freq*tauLP))*funcLP(tt,tauLP) );
    if( ipt == 0 )
      {
	hHigP -> SetBinContent(ipt+1, 1.-1./freq*(1.-0.5/(freq*tauHP))*funcLP(tt,tauHP) );
      }
    else
      {
	hHigP -> SetBinContent(ipt+1, 0.-1./freq*(1.-0.5/(freq*tauHP))*funcLP(tt,tauHP) );
      }
  }
  
  
  //-------------
  // convolutions
  hConvol(hSiPM,hLowP,hOuTotLP);
  hConvol(hSiPM,hHigP,hOuTotHP);
  
  
  TFile* outfile = TFile::Open("test.root","RECREATE");
  hSiPM -> Write();
  hLowP -> Write();
  hHigP -> Write();
  hOuTotLP -> Write();
  hOuTotHP -> Write();
  outfile->Close();
  
  return 0;
}
